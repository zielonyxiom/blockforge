# BlockForge settings. start.bat / start.sh copy this file to .env on first run.
# You can also change everything in the app: Settings (top right).
# .env is in .gitignore — your keys never leave your PC.
PORT=5177

# ── AI brain (plans + builds the model inside the app) ─────────────────────
# gemini (free key: https://aistudio.google.com) | openrouter (free models) | ollama (local)
# | openai | anthropic. Not needed if you build from Claude Code via MCP (see README).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Optional: comma list of models to fall back to when one hits its free daily quota
LLM_FALLBACK_MODELS=
# Optional: any OpenAI-compatible endpoint (Groq, LM Studio, …)
LLM_BASE_URL=
LLM_MAX_TURNS=18
CLAUDE_MAX_TURNS=60

# ── 3D scan (picture → 3D on Hugging Face, free) ───────────────────────────
# A free token gives much more GPU time: https://huggingface.co/settings/tokens
HF_TOKEN=
MESH_BACKEND=trellis
TRELLIS_SPACE=trellis-community/TRELLIS
TRELLIS2_SPACE=microsoft/TRELLIS.2
HUNYUAN_SPACE=tencent/Hunyuan3D-2

# ── Reference pictures (only for "Run pipeline" from a text prompt) ─────────
# pollinations (free, no key) | hf_space (free FLUX, uses HF_TOKEN) | cloudflare (free quota)
# | gemini | huggingface | openai
IMAGE_PROVIDER=pollinations
POLLINATIONS_TOKEN=
POLLINATIONS_MODEL=flux
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-dev
HF_EDIT_MODEL=black-forest-labs/FLUX.1-Kontext-dev
HF_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_QUALITY=high
IMAGE_SIZE=1024x1024
